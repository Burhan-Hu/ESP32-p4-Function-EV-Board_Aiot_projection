menu "Cloud Sync"

    config CLOUD_SYNC_SERVER_URL
        string "Guardian server base URL"
        default "https://guardian.example.com"
        help
            Base URL that receives family events. For remote deployment,
            replace the placeholder with the public HTTPS origin, without a
            trailing slash, e.g. https://guardian.example.com . Plain HTTP
            remains supported for a controlled local-network demonstration.

    config CLOUD_SYNC_NTP_SERVER
        string "NTP server for timestamps"
        default "ntp.aliyun.com"
        help
            NTP server used to obtain wall-clock time for event timestamps.

endmenu
