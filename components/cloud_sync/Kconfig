menu "Cloud Sync (local cloud server)"

    config CLOUD_SYNC_SERVER_URL
        string "Cloud server base URL (LAN)"
        default "http://192.168.137.1:5000"
        help
            Base URL of the local cloud server that receives focus-session
            and alert events, e.g. http://192.168.1.100:5000 .
            Set this to the LAN IP of the PC running cloud_server.py.

    config CLOUD_SYNC_NTP_SERVER
        string "NTP server for timestamps"
        default "ntp.aliyun.com"
        help
            NTP server used to obtain wall-clock time for event timestamps.

endmenu
